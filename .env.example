# ===========================================================================
# Lovora Backend - Environment Variables
# Copy this file to .env and update secrets for production.
# Defaults match docker-compose.yml for zero-config local dev.
# ===========================================================================

# -- Database (matches docker-compose.yml) ----------------------------------
DATABASE_URL=postgresql://lovora_user:lovora_pass@localhost:5432/lovora?schema=public

# -- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -- JWT --------------------------------------------------------------------
# IMPORTANT: Change these to secure random strings in production!
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# -- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# -- Rate Limiting ----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60
